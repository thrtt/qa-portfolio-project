    {
      "name": "Auth",
      "item": [
        {
          "name": "Authentication - Create Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const responseToken = pm.response.json().token;\r",
                  "\r",
                  "pm.test(\"Token is present in the response\", () => {\r",
                  "    pm.expect(responseToken).to.exist;\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Token is a string\", () => {\r",
                  "    pm.expect(responseToken).to.be.a('string');\r",
                  "})\r",
                  "\r",
                  "pm.test(\"Status code is 200\", () => {\r",
                  "    pm.response.to.have.status(200);\r",
                  "});\r",
                  "pm.test(\"Response time is less than 1000ms\", () => {\r",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"token\", responseToken);"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\r\n    \"username\" : \"admin\",\r\n    \"password\" : \"password123\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/auth",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth"
              ]
            }
          },
          "response": []
        }
      ]
