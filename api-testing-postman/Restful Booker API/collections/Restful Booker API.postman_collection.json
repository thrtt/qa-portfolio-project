                  "    pm.expect(pm.response.responseTime).to.be.below(2000);\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Response body contains bookingid\", () => {\r",
                  "    pm.expect(response).to.have.property(\"bookingid\");\r",
                  "    pm.expect(response.bookingid).to.be.a(\"number\");\r",
                  "});\r",
                  "\r",
                  "pm.test(\"Created booking contains correct main data\", () => {\r",
                  "    pm.expect(response.booking.firstname).to.equal(\"Nikolay\");\r",
                  "    pm.expect(response.booking.lastname).to.equal(\"Matev\");\r",
                  "    pm.expect(response.booking.totalprice).to.equal(1100);\r",
                  "    pm.expect(response.booking.depositpaid).to.equal(true);\r",
                  "});\r",
                  "\r",
                  "pm.environment.set(\"bookingId\", response.bookingid);"
